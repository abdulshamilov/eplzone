# --- текст: название, описание, состав, промт для картинки ---
ANTHROPIC_API_KEY=sk-ant-...
# по умолчанию claude-opus-5; для экономии можно claude-sonnet-5 или claude-haiku-4-5
TEXT_MODEL=claude-opus-5

# --- картинка: какой провайдер используем ---
# openai | replicate | fal
IMAGE_PROVIDER=openai

OPENAI_API_KEY=sk-...
REPLICATE_API_TOKEN=r8_...
FAL_KEY=

# --- ограничения, чтобы ключ не сожгли ---
# сколько генераций с одного адреса в час
RATE_LIMIT_PER_HOUR=20
